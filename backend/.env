# Copy to .env and fill in real values. Never commit .env.

PROJECT_NAME=CVNova
DEBUG=true
API_V1_PREFIX=/api/v1

# Postgres (async driver)
DATABASE_URL=postgresql+asyncpg://cvnova:cvnova@localhost:5432/cvnova

# Redis (background jobs / rate-limit storage in later phases)
REDIS_URL=redis://localhost:6379/0

# Ollama — local LLM inference (must be running separately: `ollama serve`).
# Pull at least one model first, e.g. `ollama pull llama3`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

# CORS — comma separated origins, * only for local dev
CORS_ORIGINS=*
